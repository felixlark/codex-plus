+        if len(bindings) != 1 or not isinstance(bindings[0], ast.FunctionDef) or bindings[0].name != name or bindings[0].decorator_list:
+            raise ValueError('provider_history_loaded_inventory_changed')
+        definition = bindings[0]
+        defaults = tuple(ast.literal_eval(value) for value in definition.args.defaults)
+        actual_defaults = function.__defaults__ or () if isinstance(function, types.FunctionType) else ()
+        if len(defaults) != len(actual_defaults) or any(type(a) is not type(b) or a != b for a, b in zip(defaults, actual_defaults)):
+            raise ValueError('provider_history_loaded_defaults_changed')
+        kwdefaults = {key.arg: ast.literal_eval(value) for key, value in zip(definition.args.kwonlyargs, definition.args.kw_defaults) if value is not None}
+        if kwdefaults != (function.__kwdefaults__ or {}):
+            raise ValueError('provider_history_loaded_defaults_changed')
+        if (not isinstance(function, types.FunctionType) or function.__code__ != expected[name]
+                or function.__code__.co_filename != expected[name].co_filename):
+            raise ValueError('provider_history_loaded_code_changed')
+    if (not isinstance(_REGISTRY_PROVIDER_HISTORY_MODULE_CODE, types.CodeType)
+            or _REGISTRY_PROVIDER_HISTORY_MODULE_CODE != module_code
+            or _REGISTRY_PROVIDER_HISTORY_MODULE_CODE.co_filename != filename):
+        raise ValueError('provider_history_loaded_module_changed')
+
+
+def _registry_provider_history_anchor(value):
+    if (not isinstance(value, dict) or set(value) != {'path','sha256'} or not isinstance(value['path'], str)
+            or not Path(value['path']).is_absolute() or str(Path(value['path'])) != value['path']
+            or not isinstance(value['sha256'], str) or re.fullmatch('[a-f0-9]{64}', value['sha256']) is None):
+        raise ValueError('provider_history_anchor_unknown')
+    return value
+
