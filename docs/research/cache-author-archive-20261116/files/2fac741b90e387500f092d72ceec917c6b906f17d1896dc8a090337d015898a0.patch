+def _registry_provider_history_plist(raw):
+    class Unique(dict):
+        def __setitem__(self, key, value):
+            if key in self:
+                raise ValueError('provider_history_duplicate_plist_key')
+            super().__setitem__(key, value)
+    return plistlib.loads(raw, dict_type=Unique)
+
