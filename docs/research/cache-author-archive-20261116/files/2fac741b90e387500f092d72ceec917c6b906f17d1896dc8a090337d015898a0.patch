+        plist_path = home / 'Library/LaunchAgents/me.longbiaochen.smart-shadow.node-18765-candidate.plist'
+        plist_raw, _, _ = _registry_provider_history_read(plist_path, home, records)
+        plist = _registry_provider_history_plist(plist_raw)
+        release = Path(plist['WorkingDirectory'])
+        host = root / 'service-host/SmartShadowServiceHost.app/Contents/MacOS/SmartShadowServiceHost'
+        argv = plist['ProgramArguments']
+        if (plist['Label'] != 'me.longbiaochen.smart-shadow.node-18765-candidate'
