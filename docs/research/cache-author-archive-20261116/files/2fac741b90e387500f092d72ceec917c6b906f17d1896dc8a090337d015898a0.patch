+def _registry_provider_normal_registry_delta(request, validate_registry):
+    """纯registry窄差异；parser必须由固定代码调用方提供，不接受请求内proof。"""
+    if not callable(validate_registry):
+        raise ValueError('provider_registry_parser_required')
+    before = _registry_provider_history_json(base64.b64decode(request['registry_preimage']['raw_base64'], validate=True))
+    validate_registry(copy.deepcopy(before))
+    if request['kind'] == 'genesis':
+        return None
+    raw = base64.b64decode(request['proposed_registry_raw_base64'], validate=True)
+    after = _registry_provider_history_json(raw)
+    validate_registry(copy.deepcopy(after))
+    if type(after.get('schema_version')) is not int or after['schema_version'] != 2:
+        raise ValueError('provider_registry_v2_required')
+    # 原IM/异常及所有已有Task实体字节的JSON值保全；只增本请求选中provider映射。
+    expected = copy.deepcopy(before)
+    expected['schema_version'] = 2
+    expected.setdefault('provider_sources', {})
+    selected_names = set()
+    for scope in request['selected_scopes']:
+        account, provider = scope['account'], scope['provider']
+        name = after.get('provider_sources', {}).get('feishu', {}).get(account, {}).get(provider)
+        if not isinstance(name, str) or name not in after.get('targets', {}):
+            raise ValueError('provider_registry_selected_target_missing')
+        expected['provider_sources'].setdefault('feishu', {}).setdefault(account, {})[provider] = name
+        selected_names.add(name)
+    for name in selected_names:
+        if name not in expected['targets']:
+            expected['targets'][name] = copy.deepcopy(after['targets'][name])
+    if registry_canonical(expected) != registry_canonical(after):
+        raise ValueError('provider_registry_delta_scope')
+    if registry_canonical(before) == registry_canonical(after):
+        raise ValueError('provider_registry_no_delta')
+    return raw
+
+
+def _registry_provider_normal_compile(request, request_raw, configurations, prior_raw, validate_registry):
+    """确定性normal编译；所有输入仍是untrusted数据，返回值不能签发写权限。"""
+    validation = _registry_provider_request_data(request)
+    if type(request_raw) is not bytes or registry_canonical(_registry_provider_history_json(request_raw)) != registry_canonical(request):
+        raise ValueError('provider_plan_request_bytes_conflict')
+    desired = _registry_provider_normal_registry_delta(request, validate_registry)
+    basis = request['runtime_basis']
+    required = {basis['current_configuration_projection_sha256'],
+                basis['compatible_previous_configuration_projection_sha256']}
+    inventory = {_registry_provider_history_scope_id(v):v for v in request['producer_inventory']}
+    if type(configurations) is not list or not configurations:
+        raise ValueError('provider_plan_configuration_required')
+    observed, configs = set(), []
+    for item in configurations:
+        if type(item) is not dict or set(item) != {'projection_hash','scopes'} or type(item['scopes']) is not list:
+            raise ValueError('provider_plan_configuration_conflict')
+        ids=[]
+        for scope in item['scopes']:
+            if type(scope) is not dict or set(scope) != {'provider','account','logical_scope'}:
+                raise ValueError('provider_plan_configuration_scope_conflict')
+            key=_registry_provider_history_scope_id(scope)
+            if key not in inventory or any(scope[k] != inventory[key][k] for k in scope):
+                raise ValueError('provider_plan_configuration_scope_conflict')
+            ids.append(key)
+        if len(set(ids)) != len(ids):
+            raise ValueError('provider_plan_configuration_scope_duplicate')
+        entry={'projection_hash':item['projection_hash'],
+               'scope_inventory_hash':registry_digest(registry_canonical(sorted(ids)))}
+        if item['projection_hash'] in observed:
+            raise ValueError('provider_plan_configuration_duplicate')
+        observed.add(item['projection_hash']); configs.append(entry)
+    if observed != required:
+        raise ValueError('provider_plan_configuration_conflict')
+    if request['kind'] == 'genesis':
+        if prior_raw is not None:
+            raise ValueError('provider_plan_genesis_prior_conflict')
+        previous=None; prepared=[]
+    else:
+        if type(prior_raw) is not bytes or registry_digest(prior_raw) != request['prior_history']['sha256']:
+            raise ValueError('provider_plan_history_preimage_conflict')
+        prior=_registry_provider_history_descriptor(prior_raw)
+        previous=copy.deepcopy(request['prior_history']); prepared=copy.deepcopy(prior['prepared'])
+        old={_registry_provider_history_scope_id(v):v for v in prior['inventory']}
+        if any(key not in inventory or inventory[key] != value for key,value in old.items()):
+            raise ValueError('provider_plan_inventory_lineage')
+        if any(v['operation_id'] == request['operation_id'] for v in prepared):
+            raise ValueError('provider_plan_historical_operation_reuse')
+        # 149/通政已确认：同Task逐scope串行，一operation一prepared；先对账unknown再下一scope。
+        if len(request['selected_scopes']) != 1:
+            raise ValueError('provider_plan_serial_scope_operation_required')
+        for scope in request['selected_scopes']:
+            prepared.append(dict(scope, operation_id=request['operation_id'],request_sha256=validation['request_sha256']))
+        for item in prior['configurations']:
+            if item not in configs: configs.append(copy.deepcopy(item))
+    body={'schema':'smart-shadow.provider-registry-history/v1','history_id':request['operation_id'],
+          'previous':previous,'configurations':sorted(configs,key=lambda v:(v['projection_hash'],v['scope_inventory_hash'])),
+          'inventory':[copy.deepcopy(inventory[key]) for key in sorted(inventory)],
+          'prepared':sorted(prepared,key=lambda v:(v['operation_id'],_registry_provider_history_scope_id(v)))}
+    history_raw=registry_canonical(body)+b'\n'
+    _registry_provider_history_descriptor(history_raw)
+    digest=registry_digest(history_raw)
+    anchor={'path':str(Path.home()/'Library/Application Support/SmartShadow/runtime/provider-registry-history'/ (digest+'.json')),'sha256':digest}
+    _registry_provider_history_anchor(anchor)
+    plan={'state':'compiled_untrusted_normal_plan','operation_id':request['operation_id'],
+          'request_sha256':validation['request_sha256'],'request_file_sha256':registry_digest(request_raw),
+          'registry_preimage':copy.deepcopy(request['registry_preimage']),
+          'selected_history':anchor,'history_raw_base64':base64.b64encode(history_raw).decode(),
+          'desired_registry':None if desired is None else {'raw_base64':base64.b64encode(desired).decode(),
+              'raw_sha256':registry_digest(desired),'canonical_sha256':registry_digest(registry_canonical(_registry_provider_history_json(desired)))},
+          'service_disabled_verified':False,'authority_verified':False,'ready':False}
+    return dict(plan, plan_sha256=registry_digest(registry_canonical(plan)))
+
+
+def _registry_provider_normal_snapshot(snapshot):
+    """恢复精确整数；只用于已通过request数据核验的物理前像。"""
+    value=copy.deepcopy(snapshot)
+    value['stat']={k:int(v) for k,v in value['stat'].items()}
+    value['parents']={path:{k:int(v) for k,v in stamp.items()} for path,stamp in value['parents'].items()}
+    return value
+
+
+def _registry_provider_normal_classify(plan, current):
+    """prepared后的只读三像分类；同raw但metadata/父身份漂移绝不当after。"""
+    before=_registry_provider_normal_snapshot(plan['registry_preimage'])
+    if registry_canonical(current) == registry_canonical(before):
+        return 'preimage'
+    desired=plan['desired_registry']
+    if (desired is not None and current['path'] == before['path']
+            and current['raw_base64'] == desired['raw_base64']
+            and current['raw_sha256'] == desired['raw_sha256']
+            and current['canonical_sha256'] == desired['canonical_sha256']
+            and current['parents'] == before['parents'] and current['metadata'] == before['metadata']):
+        return 'afterimage'
+    return 'third_state'
+
+
+def _registry_provider_normal_verify_history(plan, configurations, durable):
+    """恢复时精核原durable文件身份；目录只核身份，允许其它合法history追加。"""
+    anchor=plan['selected_history']
+    if durable['descriptor'] != anchor:
+        raise ValueError('provider_plan_history_durable_conflict')
+    path=Path(anchor['path']); reads=[]
+    raw,stamp,resolved=_registry_provider_history_read(path,Path.home(),reads)
+    if (str(resolved)!=anchor['path'] or registry_digest(raw)!=anchor['sha256']
+            or stamp!=durable['file_identity']):
+        raise ValueError('provider_plan_history_identity_drift')
+    directory=_registry_provider_history_record_stamp(path.parent.lstat())
+    if any(durable['directory_identity'].get(k)!=v for k,v in directory.items()):
+        raise ValueError('provider_plan_history_directory_drift')
+    for configuration in configurations:
+        _registry_provider_history_chain(anchor,configuration)
+    _registry_provider_history_recheck(reads)
+
+
+def _registry_provider_normal_drive(request, request_raw, configurations, prior_raw,
+                                    validate_registry, verify_lock, verify_authority):
+    """私有未接线driver。真实CLI必须先取得Root固定authority verifier；JSON永远不能替代。
+
+    verifier承担真实双配置disabled、固定writer cohort和完整物理来源的复核。
+    本函数不会取得锁/变更服务；调用方必须持现有serialization+deploy.lock。
+    """
+    if not callable(verify_lock) or not callable(verify_authority):
+        raise ValueError('provider_progress_physical_verifiers_required')
+    plan=_registry_provider_normal_compile(request,request_raw,configurations,prior_raw,validate_registry)
+    root_verifier=verify_authority
+    def verify_authority():
+        digest=root_verifier()
+        if type(digest) is not str or re.fullmatch('[a-f0-9]{64}',digest) is None:
+            raise ValueError('provider_authority_observation_required')
+        return digest
+    verify_lock(); verify_authority()
+    progress=_registry_provider_progress_read()
+    if progress['state']=='missing':
+        if request['kind']!='genesis': raise ValueError('provider_progress_missing')
+        records=[]
+    elif progress['state']=='parsed_untrusted':
+        records=copy.deepcopy(progress['records'])
+    else:
+        raise ValueError('provider_progress_state_unknown')
+    operation=request['operation_id']
+    progress_state=_registry_provider_progress_validate(records)
+    # 串行scope事务不能以新operation越过原CAS unknown；原operation仅准三像对账。
+    if (progress_state['pending_registry_operations']
+            and operation not in progress_state['pending_registry_operations']):
+        raise ValueError('provider_progress_registry_effect_unknown')
+    # 尚未写下durable根的事务（含intent后崩溃恢复）必须承接最新根。
+    # 已有intent不持有history head；不能恢复旧根并抹去其后其它事务事实。
+    if request['kind']=='prepare' and not any(
+            row['operation_id']==operation and row['event']=='history_durable' for row in records):
+        heads=[row['payload']['descriptor'] for row in records if row['event']=='history_durable']
+        if not heads or request['prior_history']!=heads[-1]:
+            raise ValueError('provider_plan_history_head_conflict')
+    # 每次resume重新绑定原请求/原前像/原history；不从日志补造原件。
+    if any(row['operation_id']==operation for row in records):
+        _registry_provider_normal_plan_data(request,request_raw,records)
+    def authority_observation():
+        # 由尚待Root接线的固定verifier返回其真实观测摘要；绝不拿物理前像hash冒充authority。
+        digest=verify_authority()
+        if type(digest) is not str or re.fullmatch('[a-f0-9]{64}',digest) is None:
+            raise ValueError('provider_authority_observation_required')
+        return digest
+    def append(step,event,payload):
+        row=_registry_provider_progress_next(records,operation,plan['request_sha256'],plan['request_file_sha256'],step,event,payload)
+        _registry_provider_progress_append(records,row,verify_lock,verify_authority)
+        records.append(row)
+    def intent(step):
+        append(step,'intent',{'request_file_sha256':plan['request_file_sha256'],'step':step,
+            'registry_preimage_sha256':request['registry_preimage']['raw_sha256'],
+            'prior_history':copy.deepcopy(request['prior_history'])})
+    lane=[row for row in records if row['operation_id']==operation]
+    durable=[row for row in lane if row['event']=='history_durable']
+    if durable:
+        _registry_provider_normal_verify_history(plan,configurations,durable[-1]['payload'])
+    commit=[row for row in lane if row['event']=='cas_prepared']
+    if commit:
+        payload=commit[-1]['payload']
+        if payload['plan_sha256'] != plan['plan_sha256']:
+            raise ValueError('provider_plan_prepared_plan_conflict')
+        verify_lock(); verify_authority()
+        current,_=registry_read_pinned_registry(Path(request['registry_preimage']['path']))
+        classification=_registry_provider_normal_classify(plan,current)
+        # journal已terminal时也只回读，绝不再写或再CAS。
+        if any(row['event'] in ('registry_committed','registry_observed_after') for row in lane):
+            if classification != 'afterimage': raise ValueError('provider_registry_terminal_drift')
+            return {'state':'terminal_registry_observed','adopted':False,'ready':False}
+        if classification != 'afterimage':
+            return {'state':'registry_effect_unknown','classification':classification,'adopted':False,'ready':False}
+        verify_lock(); authority_sha=authority_observation()
+        append('commit_registry','registry_observed_after',{'registry_after':current,
+            'selected_history':plan['selected_history'],'authority_observation_sha256':authority_sha})
+        return {'state':'registry_observed_after','adopted':False,'ready':False}
+    step='create_genesis' if request['kind']=='genesis' else 'append_prepared_history'
+    if not durable:
+        if not lane: intent(step)
+        result=_registry_provider_history_append(base64.b64decode(plan['history_raw_base64'],validate=True),verify_lock,verify_authority)
+        history_payload={k:result[k] for k in ('descriptor','file_identity','directory_identity')}
+        append(step,'history_durable',history_payload)
+        _registry_provider_normal_verify_history(plan,configurations,history_payload)
+    elif durable[-1]['payload']['descriptor'] != plan['selected_history']:
+        raise ValueError('provider_plan_history_durable_conflict')
+    if request['kind']=='genesis':
+        return {'state':'history_physically_durable','selected_history':plan['selected_history'],'adopted':False,'ready':False}
+    # 完整链实读含全部原prepared事实；原文件坏尾/历史缺口不补签。
+    _registry_provider_progress_registry_fence(records,operation)
+    if not any(row['operation_id']==operation and row['event']=='intent' and row['payload']['step']=='commit_registry' for row in records):
+        intent('commit_registry')
+    verify_lock(); verify_authority()
+    current,_=registry_read_pinned_registry(Path(request['registry_preimage']['path']))
+    if _registry_provider_normal_classify(plan,current) != 'preimage':
+        raise ValueError('provider_registry_preimage_conflict')
+    # 此值仅绑定本次pre-CAS观测，绝不是runtime authority证明。
+    fence=registry_digest(registry_canonical(current))
+    append('commit_registry','cas_prepared',{'plan_sha256':plan['plan_sha256'],
+        'registry_preimage':plan['registry_preimage'],'desired_registry':plan['desired_registry'],
+        'selected_history':plan['selected_history'],'physical_fence_sha256':fence})
+    # 一次CAS；其后任意异常保留prepared。重入只走上面的三像对账。
+    registry_conditional_replace(Path(current['path']),current,
+        base64.b64decode(plan['desired_registry']['raw_base64'],validate=True),verify_lock,verify_authority)
+    verify_lock(); authority_sha=authority_observation()
+    after,_=registry_read_pinned_registry(Path(current['path']))
+    if _registry_provider_normal_classify(plan,after) != 'afterimage':
+        raise ValueError('provider_registry_effect_unknown_readback_required')
+    append('commit_registry','registry_committed',{'registry_after':after,
+        'selected_history':plan['selected_history'],'authority_observation_sha256':authority_sha})
+    return {'state':'registry_physically_committed','adopted':False,'ready':False}
+
+
+def _registry_provider_normal_plan_data(request, request_raw, records):
+    """正常计划的纯数据组装；不读现场、不生成descriptor、不调用writer或自授权。"""
+    validation = _registry_provider_request_data(request)
+    if (type(request_raw) is not bytes
+            or registry_canonical(_registry_provider_history_json(request_raw)) != registry_canonical(request)):
+        raise ValueError('provider_plan_request_bytes_conflict')
+    canonical_sha = validation['request_sha256']
+    raw_sha = registry_digest(request_raw)
+    resume = _registry_provider_progress_resume_proposal(
+        records, request['operation_id'], canonical_sha, raw_sha, request['kind'])
+    # 哈希相同只绑定请求；每个原intent还必须确实记录该请求的前像与原根。
+    # 不能据一个内部自洽但内容不符的日志提出下一步，更不能重建历史意图。
+    history = None
+    for record in records:
+        if record['operation_id'] != request['operation_id']:
+            continue
+        payload = record['payload']
+        if record['event'] == 'intent':
+            if (payload['registry_preimage_sha256'] != request['registry_preimage']['raw_sha256']
+                    or payload['prior_history'] != request['prior_history']):
+                raise ValueError('provider_plan_intent_request_conflict')
+        elif record['event'] == 'history_durable':
+            history = payload['descriptor']
+        elif record['event'] == 'cas_prepared':
+            # 已prepared只能对账；也核其完整blob确实属于同一原请求，绝不补签。
+            desired_raw = base64.b64decode(request['proposed_registry_raw_base64'], validate=True)
+            desired = {'raw_base64':request['proposed_registry_raw_base64'],
+                       'raw_sha256':request['proposed_registry_sha256'],
+                       'canonical_sha256':registry_digest(registry_canonical(
+                           _registry_provider_history_json(desired_raw)))}
+            if (registry_canonical(payload['registry_preimage']) != registry_canonical(request['registry_preimage'])
+                    or payload['desired_registry'] != desired
+                    or payload['selected_history'] != history):
+                raise ValueError('provider_plan_prepared_request_conflict')
+        elif record['event'] in ('registry_committed', 'registry_observed_after'):
+            if payload['selected_history'] != history:
+                raise ValueError('provider_plan_terminal_history_conflict')
+    state = _registry_provider_progress_validate(records)
+    # 固定disabled边界在此独立核：自洽hash、scope或日志不准许开启D。
+    registry = _registry_provider_history_json(base64.b64decode(
+        request['registry_preimage']['raw_base64'], validate=True))
+    proposed_sha = None
+    if request['kind'] == 'prepare':
+        proposed = _registry_provider_history_json(base64.b64decode(
+            request['proposed_registry_raw_base64'], validate=True))
+        proposed_sha = registry_digest(registry_canonical(proposed))
+        registries = (registry, proposed)
+    else:
+        registries = (registry,)
+    for value in registries:
+        # enabled归service配置；真实registry v2不能含该键。此处只拒绝旧错误fixture
+        # 的显式启用值，不能据缺字段/false对真实服务签发disabled证明。
+        if 'codex_decision' in value:
+            decision=value['codex_decision']
+            if type(decision) is not dict or decision.get('enabled') is not False:
+                raise ValueError('provider_plan_disabled_boundary_unverified')
+        elif type(value.get('schema_version')) is not int or value['schema_version'] not in (1,2):
+            raise ValueError('provider_plan_registry_shape_unknown')
+    # 计划中只有已给定数据的精确绑定及待核接缝；不返回可执行参数/写许可。
+    # progress/missing始终由调用者拒绝，不能把[]或新UUID当作初始化证明。
+    return {'state':'validated_untrusted_normal_plan_data',
+            'request_sha256':canonical_sha, 'request_file_sha256':raw_sha,
+            'operation_id':request['operation_id'], 'kind':request['kind'],
+            'registry_preimage_sha256':validation['registry_raw_sha256'],
+            'proposed_registry_canonical_sha256':proposed_sha,
+            'service_disabled_verified':False,
+            'producer_scope_ids':[_registry_provider_history_scope_id(item)
+                                  for item in request['producer_inventory']],
+            'selected_scope_ids':[_registry_provider_history_scope_id(item)
+                                  for item in request.get('selected_scopes', [])],
+            'resume_proposal':copy.deepcopy(resume),
+            'writer_plan':{'state':'untrusted_binding_only',
+                'step':resume['step'], 'registry_path':request['registry_preimage']['path'],
+                'history_reference':copy.deepcopy(history),
+                'progress_sequence':state['record_count'],
+                'progress_sha256':state['last_record_sha256'],
+                'pending_registry_operations':list(state['pending_registry_operations']),
+                'required_writer_seams':['registry_lock_guard', 'registry_conditional_replace'],
+                'ready':False},
+            'ready':False}
+
+
+def registry_provider_cli(argv):
+    """真实只读分流；写入口尚缺正常双端权源时拒绝，不落盘。"""
+    argv = list(argv)
+    if argv == ['registry-provider-history-root']:
+        return _registry_provider_history_cli()
+    parser = argparse.ArgumentParser(description='provider正常来源只读计划；缺双端权源不产生写许可')
+    parser.add_argument('action', choices=('registry-provider-plan', 'registry-provider-apply'))
+    parser.add_argument('--holder', required=True, type=single_line)
+    parser.add_argument('--reason', required=True, type=single_line)
+    parser.add_argument('--plan', required=True, type=Path)
+    parser.add_argument('--held-lock-inode', type=int)
+    parser.add_argument('--owner-birth')
+    args = parser.parse_args(argv)
+    if ((args.held_lock_inode is None) != (args.owner_birth is None)
+            or args.action == 'registry-provider-plan' and args.held_lock_inode is not None):
+        parser.error('held-lock仅apply且inode/birth必须成对')
+    try:
+        reads = []
+        request_raw, request_stat, _ = _registry_provider_history_read(args.plan, Path.home(), reads)
+        if stat.S_IMODE(int(request_stat['st_mode'])) != 0o600:
+            raise ValueError('provider_request_requires_private_file')
+        request = _registry_provider_history_json(request_raw)
+        _registry_provider_request_envelope(request)
+        # 当前getter只有正常current定位；没有经Root核定的compatible previous
+        # 物理定位/正常来源原件不能形成ready，更不能由请求中的proof/closed替代。
+        data_validation = {'state':'unknown'}
+        data_blockers = []
+        try:
+            data_validation = _registry_provider_request_data(request)
+        except (ValueError, TypeError, KeyError, OverflowError):
+            data_blockers.append('provider_request_data_unverified')
+        observation = registry_provider_history_root()
+        progress_observation = {'state':'unknown'}
+        resume_proposal = None
+        normal_plan_data = None
+        progress_blockers = []
+        try:
+            progress_observation = _registry_provider_progress_read(reads)
+            if (progress_observation['state'] == 'parsed_untrusted'
+                    and data_validation.get('state') == 'validated_untrusted_request_data'):
+                normal_plan_data = _registry_provider_normal_plan_data(
+                    request, request_raw, progress_observation['records'])
+                resume_proposal = normal_plan_data['resume_proposal']
+                progress_blockers.extend(resume_proposal['blockers'])
+            else:
+                # 缺失不等于无历史；不自洽请求也不能据日志提出步骤。
+                progress_blockers.append('provider_progress_resume_unverified'
+                    if progress_observation['state'] == 'parsed_untrusted'
+                    else 'provider_progress_initialization_unverified')
+        except (ValueError, OSError, KeyError, TypeError) as error:
+            progress_blockers.append(str(error) if isinstance(error, ValueError)
+                                     else 'provider_progress_observation_unknown')
+        blockers = data_blockers + progress_blockers
+        if observation.get('state') != 'observed':
+            blockers.append('provider_bootstrap_metadata_not_authority' if observation.get('state') == 'metadata_only'
+                            else observation.get('reason') or 'provider_history_observation_unknown')
+        blockers.extend(['provider_compatible_previous_unknown', 'provider_request_authority_unverified',
+                         'provider_normal_planner_not_implemented', 'provider_normal_writer_not_implemented'])
+        if args.action == 'registry-provider-apply':
+            raise ValueError('provider_apply_authority_unknown')
+        result = {'schema':'smart-shadow.provider-registry-plan/v1',
+                  'request':request, 'request_sha256':registry_digest(registry_canonical(request)),
+                  'step':resume_proposal['step'] if resume_proposal else 'reconcile',
+                  'observed':{'controller_history':observation, 'request_data':data_validation,
+                      'progress':progress_observation, 'resume_proposal':resume_proposal,
+                      'normal_plan_data':normal_plan_data,
+                      'request_file':{'path':str(args.plan),'raw_sha256':registry_digest(request_raw),'stat':request_stat}},
+                  'descriptor_proposal':None, 'desired_registry':None,
+                  'ready':False, 'blockers':blockers}
+        _registry_provider_history_recheck(reads)
+        print(json.dumps(result, ensure_ascii=False, sort_keys=True))
+        return 0
+    except (Fault, ValueError, OSError, KeyError, TypeError, RuntimeError) as error:
+        print(str(error) if isinstance(error, (Fault, ValueError, RuntimeError)) else 'provider_request_io_failed', file=sys.stderr)
+        return 1
+
+
+def _registry_provider_history_cli():
