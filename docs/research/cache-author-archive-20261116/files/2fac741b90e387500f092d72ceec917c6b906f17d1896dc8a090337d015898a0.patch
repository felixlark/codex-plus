+def _registry_provider_history_append(raw, verify_lock, verify_authority):
+    """固定内容寻址history IO；仅返回物理durable，不签发采用/CAS资格。
+
+    正常CLI未取得独立authority前不调用；回调由后续真实writer接入，不能以请求JSON替代。
+    目录必须由原owner事先建立；不mkdir、不覆盖、不删除坏尾、不生成第二份descriptor。
+    """
+    if type(raw) is not bytes:
+        raise ValueError('provider_history_bytes_required')
+    _registry_provider_history_descriptor(raw)
+    if not callable(verify_lock) or not callable(verify_authority):
+        raise ValueError('provider_history_physical_verifiers_required')
+    home = Path.home()
+    directory = home / 'Library/Application Support/SmartShadow/runtime/provider-registry-history'
+    path = directory / (registry_digest(raw) + '.json')
+    parents = _registry_provider_history_parents(path, home)
+    before = directory.lstat()
+    identity = lambda info: (info.st_dev, info.st_ino, info.st_uid, info.st_gid, info.st_mode)
+    if (directory.resolve(strict=True) != directory or before.st_uid != os.getuid()
+            or not stat.S_ISDIR(before.st_mode) or stat.S_IMODE(before.st_mode) != 0o700):
+        raise ValueError('provider_history_directory_identity')
+    # 固定目标存在性与完整前像；无关兄弟目录世代不能替代目标absence证明。
+    try:
+        target_before = _registry_provider_history_stamp(path.lstat())
+    except FileNotFoundError:
+        target_before = None
+    verify_lock()
+    verify_authority()
+    _registry_provider_history_recheck(parents)
+    try:
+        target_now = _registry_provider_history_stamp(path.lstat())
+    except FileNotFoundError:
+        target_now = None
+    if target_now != target_before:
+        raise ValueError('provider_history_file_drift')
+    directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    fd, created = None, False
+    try:
+        if identity(os.fstat(directory_fd)) != identity(before):
+            raise ValueError('provider_history_directory_drift')
+        if target_before is None:
+            # 初始缺失只接受本次EXCL创建；竞争者创建的同字节文件也不能转作恢复。
+            fd = os.open(path.name, os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_NONBLOCK,
+                         0o600, dir_fd=directory_fd)
+            created = True
+        else:
+            # 初始存在不得CREATE；删除或替换须保留unknown，由原owner核查。
+            fd = os.open(path.name, os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory_fd)
+        info = os.fstat(fd)
+        if not created and _registry_provider_history_stamp(info) != target_before:
+            raise ValueError('provider_history_file_drift')
+        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
+                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600):
+            raise ValueError('provider_history_file_identity')
+        if _registry_provider_history_stamp(path.lstat()) != _registry_provider_history_stamp(info):
+            raise ValueError('provider_history_file_drift')
+        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        def exact_read():
+            os.lseek(fd, 0, os.SEEK_SET)
+            chunks = []
+            while True:
+                chunk = os.read(fd, 65536)
+                if not chunk:
+                    break
+                chunks.append(chunk)
+            if b''.join(chunks) != raw:
+                raise ValueError('provider_history_content_conflict')
+        # 同键恢复只接受exact bytes；坏尾与第三像不补写。历史inode连续性另由正常authority核。
+        if not created:
+            exact_read()
+            if _registry_provider_history_stamp(os.fstat(fd)) != _registry_provider_history_stamp(info):
+                raise ValueError('provider_history_file_drift')
+        # 创建本文件会改变目录mtime/ctime；其它祖先身份仍须精等。
+        _registry_provider_history_recheck(parents[:-1])
+        if identity(directory.lstat()) != identity(before) or directory.resolve(strict=True) != directory:
+            raise ValueError('provider_history_directory_drift')
+        verify_lock()
+        verify_authority()
+        _registry_provider_history_recheck(parents[:-1])
+        if (identity(directory.lstat()) != identity(before)
+                or directory.resolve(strict=True) != directory
+                or _registry_provider_history_stamp(path.lstat()) != _registry_provider_history_stamp(info)
+                or _registry_provider_history_stamp(os.fstat(fd)) != _registry_provider_history_stamp(info)):
+            raise ValueError('provider_history_file_or_directory_drift')
+        if created and os.write(fd, raw) != len(raw):
+            raise ValueError('provider_history_write_unknown')
+        os.fsync(fd)
+        os.fsync(directory_fd)
+        info = os.fstat(fd)
+        exact_read()
+        if (_registry_provider_history_stamp(os.fstat(fd)) != _registry_provider_history_stamp(info)
+                or _registry_provider_history_stamp(path.lstat()) != _registry_provider_history_stamp(info)):
+            raise ValueError('provider_history_file_drift')
+        _registry_provider_history_recheck(parents[:-1])
+        if identity(directory.lstat()) != identity(before) or directory.resolve(strict=True) != directory:
+            raise ValueError('provider_history_directory_drift')
+        verify_lock()
+        verify_authority()
+        _registry_provider_history_recheck(parents[:-1])
+        if (identity(directory.lstat()) != identity(before)
+                or directory.resolve(strict=True) != directory
+                or _registry_provider_history_stamp(path.lstat()) != _registry_provider_history_stamp(info)
+                or _registry_provider_history_stamp(os.fstat(fd)) != _registry_provider_history_stamp(info)):
+            raise ValueError('provider_history_file_or_directory_drift')
+        return {'state':'history_physically_durable', 'descriptor':{'path':str(path),'sha256':registry_digest(raw)},
+                'file_identity':_registry_provider_history_stamp(info),
+                'directory_identity':_registry_provider_history_stamp(directory.lstat())}
+    finally:
+        if fd is not None:
+            os.close(fd)
+        os.close(directory_fd)
+
+
+def _registry_provider_history_scope_id(item):
+    return registry_digest(registry_canonical([item['provider'], item['account'], item['logical_scope']]))
+
