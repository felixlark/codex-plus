+def _registry_provider_history_descriptor(raw):
+    """精读现有 Node history/v1 数据合同；解析成功不赋予 latest/CAS 资格。"""
+    value = _registry_provider_history_json(raw)
+    digest = lambda v: isinstance(v, str) and re.fullmatch('[a-f0-9]{64}', v) is not None
+    uuid = lambda v: isinstance(v, str) and re.fullmatch(
+        '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}'
+        '|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff', v) is not None
+    def scope(item, extra):
+        if (type(item) is not dict or set(item) != {'provider','account','logical_scope'} | extra
+                or item['provider'] not in ('feishu_task','feishu_approval')
+                or not isinstance(item['account'], str) or not item['account']
+                or item['logical_scope'] != ('task' if item['provider'] == 'feishu_task' else 'approval') + '-user-visible/v1'):
+            raise ValueError('provider_history_scope_unknown')
+    if (type(value) is not dict or set(value) != {'schema','history_id','previous','configurations','inventory','prepared'}
+            or value['schema'] != 'smart-shadow.provider-registry-history/v1' or not uuid(value['history_id'])
+            or any(type(value[k]) is not list for k in ('configurations','inventory','prepared'))):
+        raise ValueError('provider_history_descriptor_schema')
+    if value['previous'] is not None:
+        _registry_provider_history_anchor(value['previous'])
+    for item in value['configurations']:
+        if (type(item) is not dict or set(item) != {'projection_hash','scope_inventory_hash'}
+                or not all(digest(v) for v in item.values())):
+            raise ValueError('provider_history_configuration_unknown')
+    for item in value['inventory']:
+        scope(item, {'authority_sha256'})
+        if not digest(item['authority_sha256']):
+            raise ValueError('provider_history_inventory_unknown')
+    for item in value['prepared']:
+        scope(item, {'operation_id','request_sha256'})
+        if not uuid(item['operation_id']) or not digest(item['request_sha256']):
+            raise ValueError('provider_history_prepared_unknown')
+    if registry_canonical(value) + b'\n' != raw:
+        raise ValueError('provider_history_noncanonical')
+    return value
+
