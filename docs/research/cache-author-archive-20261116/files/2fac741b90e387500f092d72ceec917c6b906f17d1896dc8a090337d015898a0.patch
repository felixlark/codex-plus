+        if (phase != _REGISTRY_PROVIDER_PHASE or anchor != _REGISTRY_PROVIDER_HISTORY_ANCHOR or families != _REGISTRY_PROVIDER_FAMILIES
+                or consumers != _REGISTRY_PROVIDER_CONSUMER_CONTRACTS or legacy != _REGISTRY_FORMAL_FAMILIES):
+            raise ValueError('provider_history_loaded_literals_changed')
+        if type(consumers) is not dict:
+            raise ValueError('provider_history_consumer_contracts_unknown')
+        for name in ('_REGISTRY_PROVIDER_HISTORY_NINE','_REGISTRY_PROVIDER_HISTORY_COMMON','_REGISTRY_PROVIDER_HISTORY_SPECIFIC'):
+            if _registry_provider_history_literal(tree, name) != globals()[name]:
