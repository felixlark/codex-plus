+def _registry_provider_history_chain(anchor, configuration):
+    """只读选定链及其物理身份；返回 parsed_untrusted，不能由此自签当前根。"""
+    anchor = _registry_provider_history_json(registry_canonical(_registry_provider_history_anchor(anchor)))
+    configuration = _registry_provider_history_json(registry_canonical(configuration))
+    if (type(configuration) is not dict or set(configuration) != {'projection_hash','scopes'}
+            or not isinstance(configuration['projection_hash'], str)
+            or re.fullmatch('[a-f0-9]{64}', configuration['projection_hash']) is None
+            or type(configuration['scopes']) is not list):
+        raise ValueError('provider_history_configuration_unknown')
+    ids = []
+    for item in configuration['scopes']:
+        if (type(item) is not dict or set(item) != {'provider','account','logical_scope'}
+                or item['provider'] not in ('feishu_task','feishu_approval')
+                or not isinstance(item['account'], str) or not item['account']
+                or item['logical_scope'] != ('task' if item['provider'] == 'feishu_task' else 'approval') + '-user-visible/v1'):
+            raise ValueError('provider_history_scope_unknown')
+        ids.append(_registry_provider_history_scope_id(item))
+    if len(set(ids)) != len(ids):
+        raise ValueError('provider_history_configuration_ambiguous')
+    directory = Path(anchor['path']).parent
+    before = directory.lstat()
+    if (directory.resolve(strict=True) != directory or not stat.S_ISDIR(before.st_mode)
+            or before.st_uid != os.getuid() or stat.S_IMODE(before.st_mode) != 0o700):
+        raise ValueError('provider_history_directory_identity')
+    directory_stamp = _registry_provider_history_stamp(before)
+    records, reads, seen = [], [], set()
+    selected = anchor
+    while selected is not None:
+        path = Path(selected['path'])
+        if str(path) in seen or selected['sha256'] in seen:
+            raise ValueError('provider_history_cycle')
+        seen.update((str(path), selected['sha256']))
+        if path.parent != directory or path.name != selected['sha256'] + '.json':
+            raise ValueError('provider_history_path_identity')
+        raw, stamp, resolved = _registry_provider_history_read(path, Path.home(), reads)
+        if stat.S_IMODE(int(stamp['st_mode'])) != 0o600 or registry_digest(raw) != selected['sha256']:
+            raise ValueError('provider_history_digest_or_mode_drift')
+        body = _registry_provider_history_descriptor(raw)
+        records.append({'path':str(resolved),'sha256':selected['sha256'],'body':body})
+        selected = body['previous']
+    inventory_hash = registry_digest(registry_canonical(sorted(ids)))
+    if {'projection_hash':configuration['projection_hash'],'scope_inventory_hash':inventory_hash} not in records[0]['body']['configurations']:
+        raise ValueError('provider_history_configuration_unknown')
+    prior_inventory, prior_prepared = {}, {}
+    for record in reversed(records):
+        body = record['body']
+        pairs = [registry_canonical([v['projection_hash'],v['scope_inventory_hash']]) for v in body['configurations']]
+        if len(set(pairs)) != len(pairs):
+            raise ValueError('provider_history_configuration_duplicate')
+        inventory, prepared = {}, {}
+        for item in body['inventory']:
+            key = _registry_provider_history_scope_id(item)
+            if key in inventory:
+                raise ValueError('provider_history_inventory_duplicate')
+            inventory[key] = item['authority_sha256']
+        for item in body['prepared']:
+            if _registry_provider_history_scope_id(item) not in inventory or item['operation_id'] in prepared:
+                raise ValueError('provider_history_prepared_unknown')
+            prepared[item['operation_id']] = registry_canonical(item)
+        if any(inventory.get(k) != v for k,v in prior_inventory.items()):
+            raise ValueError('provider_history_inventory_lineage')
+        if any(prepared.get(k) != v for k,v in prior_prepared.items()):
+            raise ValueError('provider_history_prepared_lineage')
+        prior_inventory, prior_prepared = inventory, prepared
+    if any(key not in prior_inventory for key in ids):
+        raise ValueError('provider_history_partial_inventory')
+    _registry_provider_history_recheck(reads)
+    if directory_stamp != _registry_provider_history_stamp(directory.lstat()) or directory.resolve(strict=True) != directory:
+        raise ValueError('provider_history_directory_drift')
+    return {'state':'parsed_untrusted','anchor':anchor,'records':records,
+            'scope_inventory_hash':inventory_hash,'controller_expected_match':'not_observed_by_cli'}
+
