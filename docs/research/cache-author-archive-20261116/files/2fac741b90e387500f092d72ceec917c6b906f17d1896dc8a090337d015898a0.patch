+def _registry_provider_history_json(raw):
+    def pairs(entries):
+        result = {}
+        for key, value in entries:
+            if key in result:
+                raise ValueError('provider_history_duplicate_json_key')
+            result[key] = value
+        return result
+    def constant(value):
+        raise ValueError('provider_history_non_json_constant')
+    return json.loads(raw.decode('utf-8'), object_pairs_hook=pairs, parse_constant=constant)
+
