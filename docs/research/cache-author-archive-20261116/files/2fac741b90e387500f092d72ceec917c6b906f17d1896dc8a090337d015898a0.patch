+                or not isinstance(argv[1], str) or not Path(argv[1]).is_absolute()):
+            raise ValueError('provider_history_node_launcher_identity')
+        startup = [(host, True, False), (Path(argv[1]), True, True), (release/'scripts/launch-node-keychain.py', False, False),
+                   (release/'node-runtime/node', True, False), (release/'service/src/main.ts', False, False), (release/'service.json', False, False)]
+        config_raw = None
+        for path, executable, system_owned in startup:
