+def _registry_provider_progress_validate(records):
+    """精状态转换表；仅核日志数据，不据日志自授Root/写权。"""
+    if type(records) is not list:
+        raise ValueError('provider_progress_records_required')
+    operations, previous = {}, None
+    digest = lambda v: isinstance(v, str) and re.fullmatch('[a-f0-9]{64}', v) is not None
+    transitions = {
+        'create_genesis': {None:'intent','intent':'history_durable'},
+        'append_prepared_history': {None:'intent','intent':'history_durable'},
+        'commit_registry': {None:'intent','intent':'cas_prepared'},
+    }
+    keys = {'schema','operation_id','request_sha256','sequence',
+            'operation_sequence','previous_record_sha256','event','payload'}
+    for sequence, record in enumerate(records, 1):
+        if (type(record) is not dict or set(record) != keys
+                or record['schema'] != 'smart-shadow.provider-registry-progress/v1'
+                or type(record['sequence']) is not int or record['sequence'] != sequence
+                or record['previous_record_sha256'] != previous
+                or not digest(record['request_sha256'])
+                or type(record['payload']) is not dict):
+            raise ValueError('provider_progress_record_conflict')
+        import uuid
+        try:
+            operation = str(uuid.UUID(record['operation_id']))
+        except (ValueError, TypeError, AttributeError):
+            raise ValueError('provider_progress_operation_required') from None
+        if operation != record['operation_id']:
+            raise ValueError('provider_progress_operation_required')
+        lane = operations.setdefault(operation, {'request_sha256':record['request_sha256'],
+            'request_file_sha256':None,'sequence':0,'steps':{},'active_step':None})
+        if (lane['request_sha256'] != record['request_sha256']
+                or type(record['operation_sequence']) is not int or record['operation_sequence'] != lane['sequence'] + 1):
+            raise ValueError('provider_progress_request_or_sequence_conflict')
+        event, payload = record['event'], record['payload']
+        step = payload.get('step') if event == 'intent' else lane['active_step']
+        if not isinstance(step, str) or step not in transitions or not isinstance(event, str):
+            raise ValueError('provider_progress_step_unknown')
+        state = lane['steps'].get(step)
+        if step == 'commit_registry' and state == 'cas_prepared':
+            expected = event if event in ('registry_committed','registry_observed_after') else None
+        else:
+            expected = transitions[step].get(state)
+        if expected is None or event != expected:
+            raise ValueError('provider_progress_transition_conflict')
+        if step == 'create_genesis' and any(k != step for k in lane['steps']):
+            raise ValueError('provider_progress_genesis_operation_conflict')
+        if step != 'create_genesis' and 'create_genesis' in lane['steps']:
+            raise ValueError('provider_progress_genesis_operation_conflict')
+        if step == 'create_genesis' and any(op != operation and 'create_genesis' in other['steps'] for op,other in operations.items()):
+            raise ValueError('provider_progress_genesis_already_started')
+        if step == 'commit_registry' and lane['steps'].get('append_prepared_history') != 'history_durable':
+            raise ValueError('provider_progress_history_not_durable')
+        if event == 'intent':
+            if (set(payload) != {'request_file_sha256','step','registry_preimage_sha256','prior_history'}
+                    or not digest(payload['request_file_sha256']) or not digest(payload['registry_preimage_sha256'])
+                    or lane['request_file_sha256'] not in (None, payload['request_file_sha256'])):
+                raise ValueError('provider_progress_intent_conflict')
+            if step == 'create_genesis':
+                if payload['prior_history'] is not None:
+                    raise ValueError('provider_progress_genesis_operation_conflict')
+            else:
+                _registry_provider_history_anchor(payload['prior_history'])
+            lane['request_file_sha256'] = payload['request_file_sha256']
+        else:
+            payload_keys = {
+                'history_durable': {'descriptor','file_identity','directory_identity'},
+                'cas_prepared': {'plan_sha256','registry_preimage','desired_registry','selected_history','physical_fence_sha256'},
+                'registry_committed': {'registry_after','selected_history','authority_observation_sha256'},
+                'registry_observed_after': {'registry_after','selected_history','authority_observation_sha256'},
+            }
+            if set(payload) != payload_keys[event]:
+                raise ValueError('provider_progress_payload_conflict')
+            if event == 'history_durable':
+                _registry_provider_history_anchor(payload['descriptor'])
+                if type(payload['file_identity']) is not dict or type(payload['directory_identity']) is not dict:
+                    raise ValueError('provider_progress_payload_conflict')
+            else:
+                _registry_provider_history_anchor(payload['selected_history'])
+                digests = ('plan_sha256','physical_fence_sha256') if event == 'cas_prepared' else ('authority_observation_sha256',)
+                objects = ('registry_preimage','desired_registry') if event == 'cas_prepared' else ('registry_after',)
+                if any(not digest(payload[k]) for k in digests) or any(type(payload[k]) is not dict for k in objects):
+                    raise ValueError('provider_progress_payload_conflict')
+            if event == 'cas_prepared' and any(other['steps'].get('commit_registry') == 'cas_prepared' for other in operations.values()):
+                raise ValueError('provider_progress_registry_effect_unknown')
+        lane['steps'][step] = event
+        lane['active_step'] = step
+        lane['sequence'] += 1
+        previous = registry_digest(registry_canonical(record) + b'\n')
+    pending = sorted(op for op,lane in operations.items() if lane['steps'].get('commit_registry') == 'cas_prepared')
+    return {'state':'validated_untrusted_progress','operations':operations,'pending_registry_operations':pending,
+            'record_count':len(records),'last_record_sha256':previous}
+
+
+def _registry_provider_progress_decode(raw):
+    """缺行/坏尾不修；空文件也不是已采用协议的空历史。"""
+    if not isinstance(raw, bytes) or not raw or not raw.endswith(b'\n'):
+        raise ValueError('provider_progress_missing_or_torn')
+    records = []
+    for line in raw.splitlines(keepends=True):
+        record = _registry_provider_history_json(line)
+        if registry_canonical(record) + b'\n' != line:
+            raise ValueError('provider_progress_noncanonical')
+        records.append(record)
+    return records, _registry_provider_progress_validate(records)
+
+
+def _registry_provider_progress_next(records, operation, canonical_sha256, raw_file_sha256, step, event, payload):
+    prior = _registry_provider_progress_validate(records)
+    lane = prior['operations'].get(operation)
+    if (event == 'intent' and (payload.get('step') != step or payload.get('request_file_sha256') != raw_file_sha256)
+            or event != 'intent' and (not lane or lane['active_step'] != step or lane['request_file_sha256'] != raw_file_sha256)):
+        raise ValueError('provider_progress_request_or_step_conflict')
+    record = {'schema':'smart-shadow.provider-registry-progress/v1','operation_id':operation,
+              'request_sha256':canonical_sha256,
+              'sequence':len(records)+1,'operation_sequence':(lane['sequence'] if lane else 0)+1,
+              'previous_record_sha256':prior['last_record_sha256'],'event':event,'payload':payload}
+    _registry_provider_progress_validate(records + [record])
+    return record
+
+
+def _registry_provider_progress_resume_proposal(records, operation, request_sha256, request_file_sha256, request_kind):
+    """只读恢复分流；日志不能证明采用/写权，prepared永不提议第二次CAS。"""
+    state = _registry_provider_progress_validate(records)
+    lane = state['operations'].get(operation)
+    if lane is None:
+        raise ValueError('provider_progress_operation_not_observed')
+    if (lane['request_sha256'] != request_sha256
+            or lane['request_file_sha256'] != request_file_sha256):
+        raise ValueError('provider_progress_resume_request_conflict')
+    step = lane['active_step']
+    if (request_kind not in ('genesis', 'prepare')
+            or (step == 'create_genesis') != (request_kind == 'genesis')):
+        raise ValueError('provider_progress_resume_kind_conflict')
+    event = lane['steps'][step]
+    blockers = ['provider_request_authority_unverified']
+    proposed_step = 'reconcile'
+    if step in ('create_genesis', 'append_prepared_history'):
+        if event == 'intent':
+            blockers.append('provider_history_durability_unknown')
+        else:
+            blockers.append('provider_history_adoption_unverified')
+    elif event == 'intent':
+        # 即使本operation尚未CAS，另operation的未决完整blob也禁止提出替换。
+        if state['pending_registry_operations']:
+            blockers.append('provider_progress_registry_effect_unknown')
+        else:
+            proposed_step = 'commit_registry'
+            blockers.append('provider_registry_commit_conditions_unverified')
+    elif event == 'cas_prepared':
+        blockers.append('provider_progress_registry_effect_unknown')
+    else:
+        blockers.append('provider_registry_terminal_observation_unverified')
+    return {'state':'validated_untrusted_resume_proposal', 'operation_id':operation,
+            'step':proposed_step, 'recorded_step':step, 'recorded_event':event,
+            'pending_registry_operations':list(state['pending_registry_operations']),
+            'ready':False, 'blockers':blockers}
+
+
+def _registry_provider_progress_registry_fence(records, operation=None):
+    # 只供实际registry副作用；不用于P/只读/history提案，不构造资源槽位。
+    state = _registry_provider_progress_validate(records)
+    if state['pending_registry_operations']:
+        raise ValueError('provider_progress_registry_effect_unknown')
+    return state
+
+
+def _registry_provider_progress_path():
+    return Path.home() / 'Library/Application Support/SmartShadow/runtime/provider-registry-operations.jsonl'
+
+
+def _registry_provider_progress_read(reads=None):
+    path = _registry_provider_progress_path()
+    reads = [] if reads is None else reads
+    try:
+        raw, stamp, resolved = _registry_provider_history_read(path, Path.home(), reads)
+    except FileNotFoundError:
+        # 调用者另核未初始化/已有协议；缺失绝不转换为空日志。
+        return {'state':'missing','path':str(path)}
+    if int(stamp['st_mode']) & 0o777 != 0o600:
+        raise ValueError('provider_progress_file_mode')
+    records, state = _registry_provider_progress_decode(raw)
+    return {'state':'parsed_untrusted','path':str(resolved),'raw_sha256':registry_digest(raw),
+            'stat':stamp,'records':records,'progress':state}
+
+
+def _registry_provider_progress_append(records, record, verify_lock, verify_authority):
+    """未来正常writer的固定日志原语；两验证回调仍须来自真实CLI，不接受JSON替代。"""
+    prior_raw = b''.join(registry_canonical(row) + b'\n' for row in records)
+    addition = registry_canonical(record) + b'\n'
+    # 先脱离caller可变对象；日志严格状态核后才触盘。
+    expected, state = _registry_provider_progress_decode(prior_raw + addition)
+    path = _registry_provider_progress_path()
+    if not callable(verify_lock) or not callable(verify_authority):
+        raise ValueError('provider_progress_physical_verifiers_required')
+    verify_lock()
+    verify_authority()
+    parents = _registry_provider_history_parents(path, Path.home())
+    directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    fd, created = None, False
+    try:
+        directory = os.fstat(directory_fd)
+        directory_id = (directory.st_dev, directory.st_ino, directory.st_uid, directory.st_gid, directory.st_mode)
+        try:
+            before = path.lstat()
+        except FileNotFoundError:
+            if records or record['event'] != 'intent' or record['payload']['step'] != 'create_genesis':
+                raise ValueError('provider_progress_missing_not_genesis')
+            # 创建动作仍需独立实际genesis权源，缺文件本身不是absence证明。
+            _registry_provider_history_recheck(parents)
+            verify_lock()
+            verify_authority()
+            fd = os.open(path.name, os.O_RDWR | os.O_APPEND | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory_fd)
+            created = True
+            os.fchmod(fd, 0o600)
+        else:
+            if (not stat.S_ISREG(before.st_mode) or before.st_uid != os.getuid()
+                    or before.st_nlink != 1 or stat.S_IMODE(before.st_mode) != 0o600):
+                raise ValueError('provider_progress_file_identity')
+            fd = os.open(path.name, os.O_RDWR | os.O_APPEND | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory_fd)
+            if _registry_provider_history_stamp(os.fstat(fd)) != _registry_provider_history_stamp(before):
+                raise ValueError('provider_progress_file_drift')
+        # Core排他另核；内核文件锁再保同一journal的read-check-append串行。
+        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        info = os.fstat(fd)
+        if info.st_size:
+            os.lseek(fd, 0, os.SEEK_SET)
+            chunks = []
+            while True:
+                chunk = os.read(fd, 65536)
+                if not chunk:
+                    break
+                chunks.append(chunk)
+            actual = b''.join(chunks)
+            _registry_provider_progress_decode(actual)
+        else:
+            if not created:
+                raise ValueError('provider_progress_missing_or_torn')
+            actual = b''
+        if actual != prior_raw:
+            raise ValueError('provider_progress_preimage_changed')
+        if _registry_provider_history_stamp(path.lstat()) != _registry_provider_history_stamp(info):
+            raise ValueError('provider_progress_file_drift')
+        now = path.parent.lstat()
+        if path.parent.resolve(strict=True) != path.parent or directory_id != (now.st_dev, now.st_ino, now.st_uid, now.st_gid, now.st_mode):
+            raise ValueError('provider_progress_directory_drift')
+        verify_lock()
+        verify_authority()
+        # 回调完成后仍须复核实际inode/父链；不能把回调调用本身当物理稳定证明。
+        _registry_provider_history_recheck(parents[:-1] if created else parents)
+        now = path.parent.lstat()
+        if (path.parent.resolve(strict=True) != path.parent
+                or directory_id != (now.st_dev, now.st_ino, now.st_uid, now.st_gid, now.st_mode)
+                or _registry_provider_history_stamp(path.lstat()) != _registry_provider_history_stamp(info)
+                or _registry_provider_history_stamp(os.fstat(fd)) != _registry_provider_history_stamp(info)):
+            raise ValueError('provider_progress_file_or_directory_drift')
+        # 一次write若短写即unknown，保留坏尾；不循环补写/截断/重建。
+        if os.write(fd, addition) != len(addition):
+            raise ValueError('provider_progress_append_unknown')
+        os.fsync(fd)
+        os.fsync(directory_fd)
+        os.lseek(fd, 0, os.SEEK_SET)
+        chunks = []
+        while True:
+            chunk = os.read(fd, 65536)
+            if not chunk:
+                break
+            chunks.append(chunk)
+        if b''.join(chunks) != prior_raw + addition:
+            raise ValueError('provider_progress_append_unknown')
+        after = os.fstat(fd)
+        if (after.st_size != len(prior_raw) + len(addition)
+                or _registry_provider_history_stamp(path.lstat()) != _registry_provider_history_stamp(after)):
+            raise ValueError('provider_progress_append_unknown')
+        verify_lock()
+        verify_authority()
+        _registry_provider_history_recheck(parents[:-1] if created else parents)
+        now = path.parent.lstat()
+        if (path.parent.resolve(strict=True) != path.parent
+                or directory_id != (now.st_dev, now.st_ino, now.st_uid, now.st_gid, now.st_mode)
+                or _registry_provider_history_stamp(path.lstat()) != _registry_provider_history_stamp(after)
+                or _registry_provider_history_stamp(os.fstat(fd)) != _registry_provider_history_stamp(after)):
+            raise ValueError('provider_progress_file_or_directory_drift')
+        return {'state':'progress_durable','path':str(path),'raw_sha256':registry_digest(prior_raw + addition),
+                'stat':_registry_provider_history_stamp(after),'progress':state}
+    finally:
+        if fd is not None:
+            os.close(fd)
+        os.close(directory_fd)
+
+
+def _registry_provider_release_pins(controller, raw):
+    """按真实目标配置的provider核完整源码；保留原B9启动链。"""
+    reads = []
+    home = controller.home
+    plist = _registry_provider_history_plist(raw)
+    release = Path(plist['WorkingDirectory'])
+    config_raw, _, _ = _registry_provider_history_read(release / 'service.json', home, reads)
+    config = _registry_provider_history_json(config_raw)
+    selected = []
+    for provider in sorted(_REGISTRY_PROVIDER_HISTORY_SPECIFIC):
+        value = config.get(provider)
+        if value is None:
+            continue
+        if (type(value) is not dict or type(value.get('enabled')) is not bool
+                or type(value.get('entries')) is not list):
+            raise Fault('provider_config_shape_unknown')
+        # configured inventory含OFF来源；只有零entries且OFF才是没有该来源。
+        if value['enabled'] or value['entries']:
+            selected.append(provider)
+    result = {}
+    for provider in selected:
+        families = _REGISTRY_PROVIDER_FAMILIES
+        if type(families) is not dict or provider not in families:
+            raise Fault('provider_generated_family_required')
+        paths = set(_REGISTRY_PROVIDER_HISTORY_COMMON) | set(_REGISTRY_PROVIDER_HISTORY_SPECIFIC[provider])
+        variants = families[provider]
+        if type(variants) is not list or not variants or any(not _registry_provider_history_family(f, paths) for f in variants):
+            raise Fault('provider_generated_family_required')
+        observed = {}
+        for relative in sorted(paths):
+            data, _, _ = _registry_provider_history_read(release / relative, home, reads)
+            observed[relative] = registry_digest(data)
+        if observed not in variants:
+            raise Fault('provider_full_family_mismatch')
+        result.update(observed)
+    _registry_provider_history_recheck(reads)
+    return result
+
+
+class ProviderRegistryGuardController(RegistryGuardController):
+    def node_release_files(self, raw):
+        pins = super().node_release_files(raw)
+        pins.update(_registry_provider_release_pins(self, raw))
+        return pins
+
+
+def registry_provider_enable_guard():
+    global Controller
+    if _REGISTRY_PROVIDER_FAMILIES is not None:
+        Controller = ProviderRegistryGuardController
+
+
+def _registry_provider_request_envelope(request):
+    """只读请求封套的精字段；尚非完整权源核证或可执行计划。"""
+    def exact(value, fields):
+        if type(value) is not dict or set(value) != set(fields.split()):
+            raise ValueError('provider_request_shape_unknown')
+    def digest(value):
+        if type(value) is not str or re.fullmatch('[a-f0-9]{64}', value) is None:
+            raise ValueError('provider_request_hash_unknown')
+    def identifier(value):
+        if type(value) is not str or re.fullmatch('[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff', value) is None:
+            raise ValueError('provider_request_operation_unknown')
+    def scopes(values, authority=False):
+        if type(values) is not list or not values:
+            raise ValueError('provider_request_inventory_unknown')
+        ids = []
+        for item in values:
+            exact(item, 'provider account logical_scope'+(' authority_sha256' if authority else ''))
+            if (item['provider'] not in ('feishu_task','feishu_approval') or type(item['account']) is not str
+                    or not item['account'] or item['logical_scope'] !=
+                    ('task' if item['provider'] == 'feishu_task' else 'approval')+'-user-visible/v1'):
+                raise ValueError('provider_request_scope_unknown')
+            if authority:
+                digest(item['authority_sha256'])
+            ids.append(_registry_provider_history_scope_id(item))
+        if ids != sorted(set(ids)):
+            raise ValueError('provider_request_inventory_order_unknown')
+    if type(request) is not dict or request.get('kind') not in ('genesis','prepare'):
+        raise ValueError('provider_request_kind_unknown')
+    exact(request, 'schema kind operation_id registry_preimage prior_history producer_inventory runtime_basis consumer_contracts evidence coverage'+
+          (' proposed_registry_raw_base64 proposed_registry_sha256 selected_scopes' if request['kind'] == 'prepare' else ''))
+    if request['schema'] != 'smart-shadow.provider-registry-request/v1':
+        raise ValueError('provider_request_schema_unknown')
+    identifier(request['operation_id'])
+    exact(request['registry_preimage'], 'path raw_base64 raw_sha256 canonical_sha256 stat parents metadata')
+    exact(request['runtime_basis'], 'normal_publication_operation_id controller_sha256 current_release compatible_previous_release current_configuration_projection_sha256 compatible_previous_configuration_projection_sha256 provider_profiles_sha256 normal_source_observation_sha256')
+    identifier(request['runtime_basis']['normal_publication_operation_id'])
+    for key, value in request['runtime_basis'].items():
+        if key.endswith('_sha256'):
+            digest(value)
+    scopes(request['producer_inventory'], True)
+    if request['kind'] == 'genesis':
+        if request['prior_history'] is not None or type(request['consumer_contracts']) is not dict or request['consumer_contracts']:
+            raise ValueError('provider_request_genesis_unknown')
+    else:
+        _registry_provider_history_anchor(request['prior_history'])
+        if type(request['consumer_contracts']) is not dict or not request['consumer_contracts']:
+            raise ValueError('provider_request_consumers_unknown')
+        digest(request['proposed_registry_sha256'])
+        scopes(request['selected_scopes'])
+    if type(request['evidence']) is not list or not request['evidence']:
+        raise ValueError('provider_request_evidence_unknown')
+    for item in request['evidence']:
+        exact(item, 'path sha256 kind owner')
+        digest(item['sha256'])
+    exact(request['coverage'], 'owner writers consumers unknowns accepted_evidence_sha256')
+    digest(request['coverage']['accepted_evidence_sha256'])
+    if request['coverage']['accepted_evidence_sha256'] != registry_digest(registry_canonical(request['evidence'])):
+        raise ValueError('provider_request_evidence_hash_mismatch')
+    return request
+
+
+
+def _registry_provider_request_data(request):
+    """纯数据自洽校验；不读现场、不恢复CAS类型、不签发任何来源或写权限。"""
+    _registry_provider_request_envelope(request)
+    def reject():
+        raise ValueError('provider_request_data_unknown')
+    def exact(value, keys):
+        if type(value) is not dict or set(value) != set(keys.split()): reject()
+    def text(value):
+        if type(value) is not str or not value.strip() or any(c in value for c in ('\0','\n','\r')): reject()
+    def path(value):
+        text(value)
+        if not Path(value).is_absolute() or str(Path(value)) != value or '..' in Path(value).parts: reject()
+    def sha(value):
+        if type(value) is not str or re.fullmatch('[a-f0-9]{64}', value) is None: reject()
+    def decimal(value):
+        # 协议中的stat十进制字符串不能用bool、浮点或舍入后的JS数替代。
+        if type(value) is not str or re.fullmatch('0|[1-9][0-9]*', value) is None: reject()
+        return int(value)
+    def strings(values):
+        if type(values) is not list: reject()
+        for value in values: text(value)
+        if len(values) != len(set(values)): reject()
+    def raw_json(value, digest):
+        if type(value) is not str: reject()
+        try:
+            raw = base64.b64decode(value, validate=True)
+            document = _registry_provider_history_json(raw)
+            if type(document) is not dict or base64.b64encode(raw).decode() != value: reject()
+            canonical = registry_canonical(document)
+        except (ValueError, TypeError, UnicodeError):
+            reject()
+        if registry_digest(raw) != digest: reject()
+        return raw, canonical
+    snapshot = request['registry_preimage']
+    path(snapshot['path'])
+    if snapshot['path'] != str(Path.home() / 'Library/Application Support/SmartShadow/runtime/channel-task-targets.json'): reject()
+    sha(snapshot['raw_sha256']); sha(snapshot['canonical_sha256'])
+    raw, canonical = raw_json(snapshot['raw_base64'], snapshot['raw_sha256'])
+    if registry_digest(canonical) != snapshot['canonical_sha256']: reject()
+    keys = 'st_dev st_ino st_uid st_gid st_mode st_nlink st_size st_mtime_ns st_ctime_ns'
+    exact(snapshot['stat'], keys)
+    stamp = {key:decimal(value) for key,value in snapshot['stat'].items()}
+    if (not stat.S_ISREG(stamp['st_mode']) or stamp['st_nlink'] != 1
+            or stat.S_IMODE(stamp['st_mode']) & 0o022 or stamp['st_size'] != len(raw)): reject()
+    parents = snapshot['parents']
+    expected_parents = {str(parent) for parent in Path(snapshot['path']).parents}
+    if type(parents) is not dict or set(parents) != expected_parents: reject()
+    for parent, fields in parents.items():
+        path(parent)
+        exact(fields, 'st_dev st_ino st_uid st_gid st_mode')
+        identity = {key:decimal(value) for key,value in fields.items()}
+        if not stat.S_ISDIR(identity['st_mode']): reject()
+    metadata = snapshot['metadata']
+    exact(metadata, 'mode uid gid nlink flags xattrs acl_sha256')
+    for key in ('mode','uid','gid','nlink','flags'):
+        if type(metadata[key]) is not int or metadata[key] < 0: reject()
+    if (metadata['mode'] != stat.S_IMODE(stamp['st_mode']) or metadata['uid'] != stamp['st_uid']
+            or metadata['gid'] != stamp['st_gid'] or metadata['nlink'] != stamp['st_nlink']): reject()
+    sha(metadata['acl_sha256'])
+    if type(metadata['xattrs']) is not dict: reject()
+    for name,digest in metadata['xattrs'].items(): text(name); sha(digest)
+    basis = request['runtime_basis']
+    path(basis['current_release']); path(basis['compatible_previous_release'])
+    identities = []
+    for item in request['evidence']:
+        path(item['path']); text(item['kind']); text(item['owner'])
+        identities.append(item['path'])
+    if len(identities) != len(set(identities)): reject()
+    coverage = request['coverage']
+    text(coverage['owner'])
+    for key in ('writers','consumers','unknowns'): strings(coverage[key])
+    if request['kind'] == 'prepare':
+        path(request['prior_history']['path'])
+        selected = {_registry_provider_history_scope_id(item) for item in request['selected_scopes']}
+        inventory = {_registry_provider_history_scope_id(item) for item in request['producer_inventory']}
+        if not selected <= inventory: reject()
+        raw_json(request['proposed_registry_raw_base64'],request['proposed_registry_sha256'])
+    # 只返回摘要，原字节、嵌套对象和caller可变引用都不转成权源。
+    return {'state':'validated_untrusted_request_data',
+            'request_sha256':registry_digest(registry_canonical(request)),
+            'registry_raw_sha256':snapshot['raw_sha256'],
+            'registry_canonical_sha256':snapshot['canonical_sha256']}
+
