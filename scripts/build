#!/bin/bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUILD_ROOT="${CODEX_PLUS_BUILD_ROOT:-$HOME/Library/Caches/codex-plus/build}"
SCRATCH="$HOME/Library/Caches/codex-plus/swift-build"
CACHE="$HOME/Library/Caches/codex-plus/swift-cache"
IDENTITY="${CSC_NAME:-Developer ID Application: LONGBIAO CHEN (HJG65XBC25)}"
cd "$ROOT"
swift build -c release --scratch-path "$SCRATCH" --cache-path "$CACHE"
BIN="$(swift build -c release --scratch-path "$SCRATCH" --cache-path "$CACHE" --show-bin-path)"
APP="$BUILD_ROOT/Codex Plus.app"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$BIN/CodexPlus" "$APP/Contents/MacOS/CodexPlus"
cp "$ROOT/AppInfo.plist" "$APP/Contents/Info.plist"
rm -f "$APP/Contents/LICENSE"
cp "$ROOT/LICENSE" "$APP/Contents/Resources/LICENSE"
cp "$ROOT/Sources/CodexPlus/Resources/"*.mjs "$APP/Contents/Resources/"
cp "$ROOT/scripts/inspect-sidebar-model.mjs" "$APP/Contents/Resources/"
ACORN="$HOME/Library/Caches/codex-plus/project-order-probe/node_modules/acorn"
if [[ ! -f "$ACORN/dist/acorn.mjs" ]]; then
  "$ROOT/scripts/setup-project-order-probe"
fi
cp "$ACORN/dist/acorn.mjs" "$APP/Contents/Resources/acorn.mjs"
cp "$ACORN/LICENSE" "$APP/Contents/Resources/ACORN-LICENSE"
xattr -cr "$APP"
codesign --force --options runtime --timestamp --sign "$IDENTITY" "$APP"
codesign --verify --deep --strict "$APP"
printf '%s\n' "$APP"
