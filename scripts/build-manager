#!/bin/bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUILD_ROOT="${SMARTSHADOW_MANAGER_BUILD_ROOT:-$HOME/Library/Caches/codex-plus/manager-build}"
SCRATCH="$HOME/Library/Caches/codex-plus/manager-swift-build"
CACHE="$HOME/Library/Caches/codex-plus/swift-cache"
IDENTITY="${CSC_NAME:-Developer ID Application: LONGBIAO CHEN (HJG65XBC25)}"
cd "$ROOT"
swift build -c release --product SmartShadowManager --scratch-path "$SCRATCH" --cache-path "$CACHE"
BIN="$(swift build -c release --product SmartShadowManager --scratch-path "$SCRATCH" --cache-path "$CACHE" --show-bin-path)"
mkdir -p "$BUILD_ROOT"
STAGE="$(mktemp -d "$BUILD_ROOT/manager.XXXXXX")"
APP="$STAGE/SmartShadow.app"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$BIN/SmartShadowManager" "$APP/Contents/MacOS/SmartShadowManager"
cp "$ROOT/ManagerInfo.plist" "$APP/Contents/Info.plist"
cp "$ROOT/LICENSE" "$APP/Contents/Resources/LICENSE"
codesign --force --options runtime --timestamp --sign "$IDENTITY" "$APP"
codesign --verify --deep --strict "$APP"
printf '%s\n' "$APP"
