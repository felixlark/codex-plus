#!/bin/bash
set -euo pipefail
export CODEX_PLUS_SOURCE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export CODEX_PLUS_MOBILE_CACHE="$HOME/Library/Caches/codex-plus/mobile"
node "$CODEX_PLUS_SOURCE_ROOT/scripts/build-mobile-preload.mjs"
test -f "$CODEX_PLUS_MOBILE_CACHE/connection.json"
mkdir -p "$CODEX_PLUS_MOBILE_CACHE/project"
xcodegen generate --spec "$CODEX_PLUS_SOURCE_ROOT/mobile/project.yml" --project "$CODEX_PLUS_MOBILE_CACHE/project"
xcodebuild -project "$CODEX_PLUS_MOBILE_CACHE/project/CodexMobile.xcodeproj" -scheme CodexMobile -configuration Debug -sdk iphonesimulator -derivedDataPath "$CODEX_PLUS_MOBILE_CACHE/derived-data" CODE_SIGNING_ALLOWED=NO build
