#!/bin/bash
set -euo pipefail
if [[ $# -ne 3 || "$1" != "--compatibility-input" ]]; then
  echo "Usage: scripts/install --compatibility-input /absolute/private/input.json /absolute/path/app" >&2; exit 2
fi
INPUT="$2"
SOURCE="$3"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TARGET="/Applications/Codex Plus.app"
MANIFEST="$(dirname "$SOURCE")/CodexPlus.package.json"
[[ "$SOURCE" = /* && "$SOURCE" != "$TARGET" ]]
EXPECTED_REQUIREMENT="$(python3 -B "$ROOT/scripts/compatibility-input.py" requirement --input "$INPUT")"
python3 -B "$ROOT/scripts/package-manifest.py" --verify --compatibility-input "$INPUT" "$SOURCE" "$MANIFEST"
codesign --verify --deep --strict -R="$EXPECTED_REQUIREMENT" "$SOURCE"
python3 "$ROOT/scripts/native_install_guard.py" "$TARGET"
STAGING="$(mktemp -d /Applications/.codexplus-install.XXXXXX)"
ditto "$SOURCE" "$STAGING/Codex Plus.app"
python3 -B "$ROOT/scripts/package-manifest.py" --verify --compatibility-input "$INPUT" "$STAGING/Codex Plus.app" "$MANIFEST"
codesign --verify --deep --strict -R="$EXPECTED_REQUIREMENT" "$STAGING/Codex Plus.app"
if [[ -e "$TARGET" ]]; then
  BACKUP="$HOME/Library/Caches/codex-plus/standalone/rollback/$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$BACKUP"; mv "$TARGET" "$BACKUP/Codex Plus.app"
fi
mv "$STAGING/Codex Plus.app" "$TARGET"
rmdir "$STAGING"
python3 -B "$ROOT/scripts/package-manifest.py" --verify --compatibility-input "$INPUT" "$TARGET" "$MANIFEST"
codesign --verify --deep --strict -R="$EXPECTED_REQUIREMENT" "$TARGET"
# File replacement does not start Plus or touch SmartShadow. #613 owns adoption.
