#!/bin/bash
set -euo pipefail
if [[ $# -ne 1 ]]; then
  printf '%s\n' 'Usage: install-manager /absolute/path/SmartShadow.app' >&2
  exit 2
fi
exec /usr/bin/python3 - "$1" <<'PY'
from pathlib import Path
import datetime,os,plistlib,shutil,subprocess,sys
candidate=Path(sys.argv[1]);target=Path('/Applications/SmartShadow.app')
if not candidate.is_absolute() or candidate.name!='SmartShadow.app' or candidate.resolve()!=candidate:
    raise SystemExit('exact candidate app path required')
required={'CFBundleIdentifier':'me.longbiaochen.smart-shadow.app','CFBundleExecutable':'SmartShadowManager'}
info=plistlib.loads((candidate/'Contents/Info.plist').read_bytes())
if any(info.get(k)!=v for k,v in required.items()):raise SystemExit('manager bundle identity mismatch')
requirement='anchor apple generic and identifier "me.longbiaochen.smart-shadow.app" and certificate leaf[subject.OU] = "HJG65XBC25"'
subprocess.run(['/usr/bin/codesign','--verify','--deep','--strict','-R','='+requirement,str(candidate)],check=True)
helper=candidate/'Contents/Library/LoginItems/SmartShadowInteraction.app'
helper_info=plistlib.loads((helper/'Contents/Info.plist').read_bytes())
if helper_info.get('CFBundleIdentifier')!='me.longbiaochen.smart-shadow.interactiond' or helper_info.get('CFBundleExecutable')!='SmartShadowInteraction':
    raise SystemExit('nested interactiond identity mismatch')
subprocess.run(['/usr/bin/codesign','--verify','--strict','-R','=anchor apple generic and identifier "me.longbiaochen.smart-shadow.interactiond" and certificate leaf[subject.OU] = "HJG65XBC25"',str(helper)],check=True)
# A live installed client must be handed off through official Computer Use first.
# Never terminate by name or let an installer touch interactiond/its windows.
rows=subprocess.check_output(['/bin/ps','-axo','pid=,comm='],text=True).splitlines()
if any(len(row.strip().split(None,1))==2 and row.strip().split(None,1)[1].startswith(str(target)+'/Contents/') for row in rows):
    raise SystemExit('installed SmartShadow UI or helper is running; formal service stop and exact UI handoff required before installation')
root=Path.home()/'Library/Caches/codex-plus/manager-installs';root.mkdir(parents=True,exist_ok=True)
backup=root/datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
backup.mkdir()
stage=Path('/Applications')/('.SmartShadow-manager-'+backup.name+'.app')
subprocess.run(['/usr/bin/ditto',str(candidate),str(stage)],check=True)
subprocess.run(['/usr/bin/codesign','--verify','--deep','--strict','-R','='+requirement,str(stage)],check=True)
if target.exists() or target.is_symlink():
    if target.is_symlink():raise SystemExit('installed app path is a symlink; preserve and reconcile before replacement')
    os.rename(target,backup/'SmartShadow.app')
try:os.rename(stage,target)
except BaseException:
    if not target.exists() and (backup/'SmartShadow.app').exists():os.rename(backup/'SmartShadow.app',target)
    raise
subprocess.run(['/usr/bin/codesign','--verify','--deep','--strict','-R','='+requirement,str(target)],check=True)
print(str(target))
print('previous installation retained at '+str(backup))
PY
